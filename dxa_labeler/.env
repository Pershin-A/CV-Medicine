# Путь к исходным DICOM на компьютере пользователя.
# Рекомендуемый вариант: папка "Исследования" внутри dxa_labeler.
DXA_DATA_DIR=./Исследования

# Путь к результатам конкретного разметчика.
# ДЛЯ КАЖДОГО ЧЕЛОВЕКА ДОЛЖНА БЫТЬ СВОЯ ПАПКА.
DXA_OUTPUT_DIR=./Размеченные

# В текущем эталонном наборе ожидается 499 DICOM.
EXPECTED_DICOM_COUNT=499

# Сначала можно оставить пустым.
# После запуска на эталонном компьютере скопируйте fingerprint
# из боковой панели и раздайте всем один и тот же fingerprint.
EXPECTED_DATASET_FINGERPRINT=

# 1 = запретить разметку при несовпадении count/fingerprint.
# Рекомендуется оставить 1.
STRICT_DATASET_CHECK=1
