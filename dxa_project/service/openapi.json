  "components": {
    "schemas": {
      "Annotation": {
        "properties": {
          "region": {
            "type": "string",
            "enum": [
              "SPINE",
              "LEG_LEFT",
              "LEG_RIGHT"
            ],
            "title": "Region"
          },
          "geometry": {
            "additionalProperties": true,
            "type": "object",
            "title": "Geometry"
          },
          "reviewed": {
            "items": {
              "type": "string",
              "enum": [
                "spine",
                "artifact",
                "hip",
                "hip_points",
                "scoliosis",
                "hip_mask",
                "spine_crests"
              ]
            },
            "type": "array",
            "title": "Reviewed"
          },
          "targets": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Targets"
          },
          "spacing_mm": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 2,
                "minItems": 2
              },
              {
                "type": "null"
              }
            ],
            "title": "Spacing Mm"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version",
